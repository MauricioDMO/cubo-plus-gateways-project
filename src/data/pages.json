    "content_html": "<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"width\":\"60%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:60%\"><!-- wp:heading {\"level\":1} -->\n<h1 class=\"wp-block-heading\">Getaways Concierge</h1>\n<!-- /wp:heading -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\"><br>Book a complimentary call, and we'll build your stay in El Salvador</h2>\n<!-- /wp:heading -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"backgroundColor\":\"white\",\"textColor\":\"black\",\"className\":\"is-style-fill\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}}} -->\n<div class=\"wp-block-button is-style-fill\"><a class=\"wp-block-button__link has-black-color has-white-background-color has-text-color has-background has-link-color wp-element-button\" href=\"/contact-us\">CONTACT US</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:hivepress/listing-tags {\"number\":\"5\",\"order\":\"item_count\",\"metadata\":{\"blockVisibility\":false}} /--></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n\n<!-- wp:more -->\n<!--more-->\n<!-- /wp:more -->\n\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\"></a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n\n<!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center\">High-end apartment rentals in El Zonte, selected for quality, comfort, and setting.</h3>\n<!-- /wp:heading -->\n\n<!-- wp:heading {\"className\":\"content-title\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center content-title\">Top Categories</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"content-subtitle\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center content-subtitle\">Explore the most popular categories.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:hivepress/listing-categories {\"columns\":\"2\",\"number\":\"2\"} /-->\n\n<!-- wp:cover {\"url\":\"/media/2021/10/image-35.png\",\"id\":285,\"dimRatio\":0,\"align\":\"wide\",\"className\":\"is-light content-section\"} -->\n<div class=\"wp-block-cover alignwide is-light content-section\"><img class=\"wp-block-cover__image-background wp-image-285\" alt=\"\" src=\"/media/2021/10/image-35.png\" data-object-fit=\"cover\"/><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:heading {\"className\":\"content-title\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center content-title\">Get started</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"content-subtitle\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center content-subtitle\">Just a few steps to book a stay.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:hivepress/feature {\"icon\":\"home\",\"caption\":\"01\"} /-->\n\n<!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center\">Find a Property</h3>\n<!-- /wp:heading --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:hivepress/feature {\"icon\":\"comment-dots\",\"caption\":\"02\"} /-->\n\n<!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center\">Check Reviews</h3>\n<!-- /wp:heading --></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:hivepress/feature {\"icon\":\"calendar-check\",\"caption\":\"03\"} /-->\n\n<!-- wp:heading {\"level\":3,\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h3 class=\"wp-block-heading has-text-align-center\">Book a Stay</h3>\n<!-- /wp:heading --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:heading {\"className\":\"content-title\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center content-title\">Top Properties</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"content-subtitle\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center content-subtitle\">Check our popular top-rated properties.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:hivepress/listings {\"columns\":\"3\",\"number\":\"6\",\"slider\":\"1\"} /-->\n\n<!-- wp:heading {\"metadata\":{\"blockVisibility\":false},\"className\":\"content-title\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center content-title\">Meet Our Hosts</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"metadata\":{\"blockVisibility\":false},\"className\":\"content-subtitle\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center content-subtitle\">Our most trusted and experienced hosts.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:hivepress/vendors {\"metadata\":{\"blockVisibility\":false}} /-->\n\n<!-- wp:heading {\"className\":\"content-title\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center content-title\">What People Say</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"content-subtitle\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center content-subtitle\">Honest feedback from our guests and hosts.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:hivepress/testimonials {\"columns\":\"1\",\"number\":\"3\",\"slider\":\"1\"} /-->\n\n<!-- wp:heading {\"className\":\"content-title\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center content-title\">From the Blog</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"className\":\"content-subtitle\",\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center content-subtitle\">Read most recent articles from our blog.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:hivepress/posts /-->\n\n<!-- wp:cover {\"url\":\"/media/2021/10/image-36.png\",\"id\":287,\"dimRatio\":0,\"align\":\"wide\",\"className\":\"is-light content-section\"} -->\n<div class=\"wp-block-cover alignwide is-light content-section\"><img class=\"wp-block-cover__image-background wp-image-287\" alt=\"\" src=\"/media/2021/10/image-36.png\" data-object-fit=\"cover\"/><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"></span><div class=\"wp-block-cover__inner-container\"><!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"className\":\"content-column\"} -->\n<div class=\"wp-block-column content-column\"><!-- wp:hivepress/feature {\"icon\":\"key\"} /-->\n\n<!-- wp:heading {\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Rent a Property</h2>\n<!-- /wp:heading -->\n\n<!-- wp:spacer {\"height\":\"16px\"} -->\n<div style=\"height:16px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\",\"orientation\":\"horizontal\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-primary\"} -->\n<div class=\"wp-block-button is-style-primary\"><a class=\"wp-block-button__link wp-element-button\" href=\"/properties\">Find a Property</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"className\":\"content-column\"} -->\n<div class=\"wp-block-column content-column\"><!-- wp:hivepress/feature {\"icon\":\"home\"} /-->\n\n<!-- wp:heading {\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<h2 class=\"wp-block-heading has-text-align-center\">Become a Host</h2>\n<!-- /wp:heading -->\n\n<!-- wp:spacer {\"height\":\"16px\"} -->\n<div style=\"height:16px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\",\"orientation\":\"horizontal\"}} -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-secondary\"} -->\n<div class=\"wp-block-button is-style-secondary\"><a class=\"wp-block-button__link wp-element-button\" href=\"/submit-listing\">List a Property</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div></div>\n<!-- /wp:cover -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->",
