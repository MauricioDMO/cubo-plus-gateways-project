    "content_html": "{\n  \"home.hero.secondaryLabel\": \"CONTACT US\",\n  \"home.hero.title\": \"Book direct on the coast now\",\n  \"home.places.title\": \"Where you can stay?\",\n  \"about.hero.image\": \"2210\",\n  \"about.team.members\": \"[{\\\"id\\\":\\\"lexi\\\",\\\"photo\\\":\\\"2200\\\",\\\"name\\\":\\\"Lexi\\\",\\\"role\\\":\\\"Founder and CEO\\\",\\\"quote\\\":\\\"\\\",\\\"photoFocus\\\":\\\"\\\"},{\\\"id\\\":\\\"andrea\\\",\\\"photo\\\":\\\"2201\\\",\\\"name\\\":\\\"Andrea\\\",\\\"role\\\":\\\"Housekeeper\\\",\\\"quote\\\":\\\"\\\",\\\"photoFocus\\\":\\\"\\\"},{\\\"id\\\":\\\"mafer\\\",\\\"photo\\\":\\\"2202\\\",\\\"name\\\":\\\"Mafer\\\",\\\"role\\\":\\\"Head of Marketing\\\",\\\"quote\\\":\\\"I love spending my free time outdoors — hitting the beach, catching waves, and losing myself on the dance floor.\\\",\\\"photoFocus\\\":\\\"\\\"},{\\\"id\\\":\\\"isabella\\\",\\\"photo\\\":\\\"2204\\\",\\\"name\\\":\\\"Isabella\\\",\\\"role\\\":\\\"Guest Experience Lead\\\",\\\"quote\\\":\\\"\\\",\\\"photoFocus\\\":\\\"\\\"},{\\\"id\\\":\\\"tatiana\\\",\\\"photo\\\":\\\"2205\\\",\\\"name\\\":\\\"Tatiana\\\",\\\"role\\\":\\\"Housekeeper\\\",\\\"quote\\\":\\\"\\\",\\\"photoFocus\\\":\\\"\\\"},{\\\"id\\\":\\\"maureen\\\",\\\"photo\\\":\\\"2206\\\",\\\"name\\\":\\\"Maureen\\\",\\\"role\\\":\\\"Content Creation\\\",\\\"quote\\\":\\\"What I love most about El Zonte is that it's a place that inspires you — life moves slower here, without so much rush.\\\",\\\"photoFocus\\\":\\\"\\\"},{\\\"id\\\":\\\"vanessa\\\",\\\"photo\\\":\\\"2207\\\",\\\"name\\\":\\\"Vanessa\\\",\\\"role\\\":\\\"Head of Design and Project Delivery\\\",\\\"quote\\\":\\\"I love traveling and discovering new places — it shapes how I see spaces. In El Zonte, I design spaces that reflect the coast and the local way of life.\\\",\\\"photoFocus\\\":\\\"\\\"},{\\\"id\\\":\\\"raquel\\\",\\\"photo\\\":\\\"2208\\\",\\\"name\\\":\\\"Raquel\\\",\\\"role\\\":\\\"Operations Manager\\\",\\\"quote\\\":\\\"I love staying organized, working as a team, and always giving my best. In my free time, I enjoy watching the sunset and spending time with my family.\\\",\\\"photoFocus\\\":\\\"\\\"},{\\\"id\\\":\\\"consuelo\\\",\\\"photo\\\":\\\"2209\\\",\\\"name\\\":\\\"Consuelo\\\",\\\"role\\\":\\\"Housekeeper\\\",\\\"quote\\\":\\\"\\\",\\\"photoFocus\\\":\\\"\\\"}]\",\n  \"home.properties.title@alignMobile\": \"left\",\n  \"about.story.title\": \"We didn't set out to run a rental company.s\",\n  \"about.hero.image@focus\": \"50% 53%\",\n  \"home.place.zonset-surf-residences.image@focusMobile\": \"51% 50%\"\n}",
