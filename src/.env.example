APP_PORT=3000
# El blog público lee las publicaciones de PostgreSQL.
POSTGRES_PORT=5432
# URL compartida por el host y Docker; Compose adapta el host local a `db`.
# Debe coincidir con el usuario, contraseña y base iniciales de PostgreSQL.
DATABASE_URL=postgresql://gateways:gateways_dev@127.0.0.1:5432/gateways
POSTGRES_DB=gateways
POSTGRES_USER=gateways
# Desarrollo usa gateways_dev si queda vacía. Obligatoria en producción.
# Usa una contraseña hexadecimal (openssl rand -hex 32), segura para DATABASE_URL.
POSTGRES_PASSWORD=
# RustFS development credentials: replace these examples locally; never reuse in production.
RUSTFS_ROOT_ACCESS_KEY=rustfs-root-dev
RUSTFS_ROOT_SECRET_KEY=replace-with-a-long-random-secret
# Create this restricted IAM user/policy in RustFS before starting the app.
S3_ACCESS_KEY_ID=blog-app-dev
S3_SECRET_ACCESS_KEY=replace-with-a-different-long-random-secret
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
# If S3_BUCKET changes, update both bucket ARNs in infrastructure/storage/blog-media-policy.json before provisioning the app identity.
S3_BUCKET=blog-media

# Staff account bootstrap/recovery uses an interactive terminal; do not put account passwords here.
# At least 32 random bytes, e.g. `openssl rand -base64 48`; keep stable across app instances.
BLOG_SESSION_SECRET=
# Exact public origin; required to accept login, logout and upload requests.
BLOG_APP_ORIGIN=http://localhost:3000
# Guest accounts reuse this secret/origin with a separate cookie and audience.
# Phase H is local-only: production/non-loopback origins stay disabled until recovery is defined.
# Enable only when a non-bypassable trusted proxy overwrites X-Real-IP.
# Without it, login attempts share a global rate limit instead of trusting client headers.
AUTH_TRUST_PROXY=0
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Private stable local key for issuing guest referral links (generate with openssl rand -hex 32).
REFERRAL_ID_SECRET=
